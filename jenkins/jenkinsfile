 pipeline {
  agent any

  environment {
    AWS_DEFAULT_REGION     = 'us-east-1'
    AWS_ACCESS_KEY_ID      = credentials('aws-access-key')
    AWS_SECRET_ACCESS_KEY  = credentials('aws-secret-key')
    DB_PASSWORD            = credentials('db-password')
    JWT_SECRET             = credentials('jwt-secret')
    ECR_REGISTRY           = 'your-account-id.dkr.ecr.us-east-1.amazonaws.com'
  }

  tools { nodejs 'NodeJS-18' }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'main', url: 'https://github.com/svpraga/Shop-Cloud.git',
            credentialsId: 'github-credentials'
      }
    }

    stage('Test Frontend') {
      steps {
        dir('frontend') {
          sh 'npm ci'
          sh 'npm run lint || true'   // '|| true' prevents lint warnings from failing the build
        }
      }
    }

    // ── TERRAFORM RUNS FIRST ─────────────────────────────────────
    stage('Terraform Apply') {
      steps {
        dir('infra') {
          sh '''
            terraform init
            terraform apply -auto-approve \
              -var="db_password=${DB_PASSWORD}" \
              -var="jwt_secret=${JWT_SECRET}"
          '''
          // Capture API Gateway ID from Terraform output → save to file
          sh 'terraform output -raw api_gateway_id > /tmp/api_gw_id.txt'
        }
      }
    }

    // ── FRONTEND BUILD USES THE REAL API GATEWAY ID ──────────────
    stage('Build Frontend') {
      steps {
        script {
          // Read the API Gateway ID that Terraform just created
          def apiGwId = readFile('/tmp/api_gw_id.txt').trim()
          def apiUrl  = "https://${apiGwId}.execute-api.us-east-1.amazonaws.com/prod"
          echo "Using API URL: ${apiUrl}"

          dir('frontend') {
            withEnv(["VITE_API_URL=${apiUrl}"]) {
              sh 'npm run build'
            }
          }
        }
        echo "✅ React app built with correct API Gateway URL"
      }
    }

     stage('Deploy Frontend to S3') {
  steps {
    script {
      dir('infra') {
        sh 'terraform output -raw bucket_name > /tmp/bucket_name.txt || echo "shopcloud-frontend" > /tmp/bucket_name.txt'
      }
      def bucketName = readFile('/tmp/bucket_name.txt').trim()
      sh "aws s3 sync frontend/dist/ s3://${bucketName} --delete"
      echo "✅ Frontend deployed to S3 bucket: ${bucketName}"
      // CloudFront invalidation skipped until distribution is created
    }
  }
}
     stage('Build Lambdas') {
  steps {
    sh '''
      for lambda in products orders auth order-worker notification; do
        echo "Packaging $lambda..."
        cd backend/lambdas/$lambda
        npm ci --omit=dev
        zip -r /tmp/${lambda}.zip index.js node_modules/ package.json
        aws s3 cp /tmp/${lambda}.zip s3://shopcloud-lambda-zips/${lambda}.zip
        echo "Uploaded $lambda to S3"
        cd ../../..
      done
    '''
    echo "✅ All Lambdas packaged and uploaded to S3"
  }
}

    stage('Build & Push Docker Image') {
      steps {
        dir('backend/admin') {
          sh '''
            aws ecr get-login-password --region us-east-1 | \
              docker login --username AWS --password-stdin ${ECR_REGISTRY}
            docker build -t shopcloud-admin .
            docker tag shopcloud-admin:latest ${ECR_REGISTRY}/shopcloud-admin:latest
            docker push ${ECR_REGISTRY}/shopcloud-admin:latest
          '''
        }
      }
    }

     stage('Deploy Lambdas to AWS') {
  steps {
    sh '''
      for lambda in products orders auth order-worker notification; do
        aws lambda update-function-code \
          --function-name shopcloud-${lambda} \
          --s3-bucket shopcloud-lambda-zips \
          --s3-key ${lambda}.zip
        echo "Deployed $lambda"
      done
    '''
    echo "✅ All Lambda functions updated"
  }
}

    stage('Redeploy ECS Admin') {
      steps {
        sh '''
          aws ecs update-service \
            --cluster shopcloud-cluster \
            --service shopcloud-admin \
            --force-new-deployment
        '''
      }
    }
  }

  post {
    success { echo "🚀 ShopCloud deployed! Build #${BUILD_NUMBER}" }
    failure { echo "❌ Pipeline failed. Check logs above." }
    always  { cleanWs() }
  }
}
